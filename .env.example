# Clés API LLM (ex: Gemini gratuit via Google AI Studio, Groq, OpenAI...)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

# Services internes Docker
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_PORT=6334
REDIS_URL=redis://redis:6379

# Reranking cross-encoder (opt-in, ~0,57 Go téléchargés, +1,7 s CPU par requête)
# RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8

# Observabilité Langfuse (à récupérer sur http://localhost:3000 après le 1er lancement)
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx